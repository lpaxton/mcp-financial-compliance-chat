
{
  "name": "mcp-financial-chat-backend-simple",
  "version": "1.0.0",
  "description": "Simple MCP Financial Chat Backend - No Auth",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "mcp:start": "concurrently \"npm run mcp:topic\" \"npm run mcp:finra\" \"npm run mcp:sec\"",
    "mcp:topic": "cd ../mcp-servers/topic-control-mcp && node index.js",
    "mcp:finra": "cd ../mcp-servers/finra-compliance-mcp && node index.js", 
    "mcp:sec": "cd ../mcp-servers/sec-compliance-mcp && node index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@modelcontextprotocol/sdk": "^0.4.0",
    "helmet": "^7.1.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "compliance",
    "finra",
    "sec",
    "chat",
    "simple"
  ]
}